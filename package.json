{
  "name": "orchestrate",
  "version": "0.3.0",
  "description": "Lightweight control layer for Claude Code — spawn, monitor, and control agents in isolated Git worktrees.",
  "type": "module",
  "scripts": {
    "dev": "node --no-experimental-webstorage node_modules/vite/bin/vite.js dev",
    "build": "node --no-experimental-webstorage node_modules/vite/bin/vite.js build",
    "preview": "vite preview",
    "prepare": "svelte-kit sync || echo ''",
    "check": "svelte-kit sync && svelte-check --tsconfig ./tsconfig.json",
    "check:watch": "svelte-kit sync && svelte-check --tsconfig ./tsconfig.json --watch",
    "test": "node --test 'src/**/*.test.ts'",
    "tauri": "tauri",
    "build:linux": "NO_STRIP=true APPIMAGE_EXTRACT_AND_RUN=1 tauri build",
    "site": "node site/serve.mjs",
    "site:build": "node site/build.mjs"
  },
  "license": "MIT",
  "dependencies": {
    "@fontsource-variable/geist": "^5.3.0",
    "@fontsource-variable/jetbrains-mono": "^5.3.0",
    "@tauri-apps/api": "^2",
    "@tauri-apps/plugin-dialog": "^2.7.3",
    "@tauri-apps/plugin-notification": "^2.4.0",
    "@tauri-apps/plugin-opener": "^2.5.5",
    "marked": "^18.0.13",
    "prism-svelte": "^0.5.0",
    "prismjs": "^1.30.0"
  },
  "devDependencies": {
    "@sveltejs/adapter-static": "^3.0.10",
    "@sveltejs/kit": "^2.65.1",
    "@sveltejs/vite-plugin-svelte": "^7.1.2",
    "@tauri-apps/cli": "^2",
    "@types/node": "^26.6.2",
    "@types/prismjs": "^1.26.6",
    "svelte": "^5.56.3",
    "svelte-check": "^4.6.0",
    "typescript": "~6.0.3",
    "vite": "^8.0.16"
  }
}
